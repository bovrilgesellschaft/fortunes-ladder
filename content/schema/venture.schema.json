{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "venture.schema.json",
  "title": "A Picaresque Venture",
  "description": "One Venture in five beats: Approach, Complication, Turn, Crisis, Reckoning. See content/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "runhead",
    "sub",
    "prospectus",
    "year",
    "week",
    "loot_flag",
    "persona",
    "who",
    "start",
    "first",
    "chapter",
    "beats",
    "reckoning"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Short id, also the file name."
    },
    "title": {
      "type": "string"
    },
    "runhead": {
      "type": "string",
      "description": "The running head: the title of the hero's memoir."
    },
    "sub": {
      "type": "string",
      "description": "Subtitle under the title, in the 'Being…' form."
    },
    "prospectus": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "minimum": 1719,
      "maximum": 1745
    },
    "week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 52,
      "description": "Calendar week of the Venture, counted from 1 January."
    },
    "loot_flag": {
      "type": "string",
      "description": "Flag set whenever a 'loot' effect is applied."
    },
    "persona": {
      "type": "string",
      "description": "The Persona's short name, as shown beside Exposure."
    },
    "who": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "as",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "start": {
      "$ref": "#/definitions/start"
    },
    "first": {
      "type": "string",
      "description": "Id of the first beat."
    },
    "chapter": {
      "$ref": "#/definitions/chapter"
    },
    "story": {
      "$ref": "#/definitions/story"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/beat"
      }
    },
    "reckoning": {
      "$ref": "#/definitions/reckoning"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "luck": {
          "type": "boolean",
          "description": "false switches off Luck earned on a Catastrophe against the odds."
        }
      }
    },
    "test": {
      "type": "boolean",
      "description": "Placeholder content written to exercise the engine (Step 5), to be kept, rewritten or dropped."
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blurb",
        "district"
      ],
      "description": "When and how often the Venture is offered in a run. Without it, it is never offered.",
      "properties": {
        "blurb": {
          "type": "string",
          "description": "A short line for the card the player chooses from."
        },
        "district": {
          "type": "string"
        },
        "when": {
          "$ref": "#/definitions/expr"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "repeat": {
          "type": "boolean"
        },
        "from": {
          "$ref": "#/definitions/when"
        },
        "to": {
          "$ref": "#/definitions/when"
        },
        "arrival": {
          "type": "boolean",
          "description": "Not offered: played in the first turn as an Origin's arrival."
        },
        "circle": {
          "enum": [
            "the Quality",
            "the Church",
            "the Law",
            "the Projectors",
            "the Army & Navy",
            "the Underworld",
            "the Wits",
            "the Trade",
            "the Brethren & the Adepts",
            "the Town"
          ],
          "description": "The circle the Venture is set in: playing it makes the Persona known there, and its rumours are that circle's talk."
        },
        "rank": {
          "enum": [
            "Vagabond",
            "Servant",
            "Tradesman",
            "Gentleman",
            "Esquire",
            "Baronet or Knight",
            "Peer"
          ],
          "description": "The Claimed Rank the Venture expects; below it, it is gate-crashed, at +1 on every Exposure gain."
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "description": "Lent for this Venture: given at the Approach; those listed under returned are taken back after the Reckoning.",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "returned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "description": "The names the text uses on the Venture's own page; in a run, the run's drawn names are used instead.",
      "required": [
        "given",
        "surname",
        "county",
        "title",
        "short_title",
        "alias_surname",
        "claim"
      ],
      "properties": {
        "given": {
          "type": "string"
        },
        "surname": {
          "type": "string"
        },
        "county": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "short_title": {
          "type": "string"
        },
        "alias_surname": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "boolean",
      "description": "Started by the run itself (the bailiff, the prison); never offered."
    },
    "sample": {
      "type": "object",
      "description": "Values the text uses on the Venture's own page, which a run supplies.",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    }
  },
  "definitions": {
    "expr": {
      "type": "string",
      "description": "A condition or sum, e.g. flags.will and spoils > 0. See content/README.md."
    },
    "amount": {
      "description": "A number, a sum of money (\"2s 6d\", \"£24\", \"20 guineas\"), or an expression after '=' (\"= -floor(spoils / 2)\").",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "text": {
      "type": "string",
      "description": "Prose. Blank lines separate paragraphs. [[term]] marks a glossary word; {fn *} a footnote marker; {if …}…{else}…{end} a condition; {expr} a value."
    },
    "passage": {
      "type": "string",
      "description": "A passage of the Story: third person, past tense, in the Story's one voice (ruled 20 October 2026)."
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purse",
        "debts",
        "luck",
        "exposure",
        "notoriety",
        "celebrity",
        "attrs",
        "hum",
        "tags",
        "items",
        "hooks"
      ],
      "properties": {
        "purse": {
          "$ref": "#/definitions/amount"
        },
        "debts": {
          "$ref": "#/definitions/amount"
        },
        "composure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Leave out: Composure starts at Nerve + 1 (ruling D2)."
        },
        "luck": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "exposure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "notoriety": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "celebrity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Address",
            "Wit",
            "Nerve",
            "Constitution",
            "Countenance",
            "Learning"
          ],
          "properties": {
            "Address": {
              "$ref": "#/definitions/score5"
            },
            "Wit": {
              "$ref": "#/definitions/score5"
            },
            "Nerve": {
              "$ref": "#/definitions/score5"
            },
            "Constitution": {
              "$ref": "#/definitions/score5"
            },
            "Countenance": {
              "$ref": "#/definitions/score5"
            },
            "Learning": {
              "$ref": "#/definitions/score5"
            }
          }
        },
        "hum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Sanguine",
            "Choleric",
            "Melancholic",
            "Phlegmatic"
          ],
          "properties": {
            "Sanguine": {
              "$ref": "#/definitions/score5"
            },
            "Choleric": {
              "$ref": "#/definitions/score5"
            },
            "Melancholic": {
              "$ref": "#/definitions/score5"
            },
            "Phlegmatic": {
              "$ref": "#/definitions/score5"
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "score5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no",
        "opening",
        "parts",
        "last"
      ],
      "properties": {
        "no": {
          "type": "string"
        },
        "opening": {
          "type": "string"
        },
        "special": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "parts"
          ],
          "properties": {
            "when": {
              "$ref": "#/definitions/expr"
            },
            "parts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "text"
            ],
            "properties": {
              "when": {
                "$ref": "#/definitions/expr"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "last": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "text",
            "else"
          ],
          "properties": {
            "when": {
              "$ref": "#/definitions/expr"
            },
            "text": {
              "type": "string"
            },
            "else": {
              "type": "string"
            }
          }
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "byline",
        "preface",
        "close"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "byline": {
          "type": "string"
        },
        "preface": {
          "$ref": "#/definitions/passage"
        },
        "close": {
          "$ref": "#/definitions/passage"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "effects": {
          "$ref": "#/definitions/effects"
        },
        "text": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/effect"
      }
    },
    "effect": {
      "description": "One change to the hero's state.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adj",
            "by"
          ],
          "properties": {
            "adj": {
              "type": "string",
              "enum": [
                "purse",
                "debts",
                "composure",
                "luck",
                "exposure",
                "notoriety",
                "celebrity",
                "hum.Sanguine",
                "hum.Choleric",
                "hum.Melancholic",
                "hum.Phlegmatic"
              ]
            },
            "by": {
              "$ref": "#/definitions/amount"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "loot"
          ],
          "properties": {
            "loot": {
              "$ref": "#/definitions/amount"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "set"
          ],
          "properties": {
            "set": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unset"
          ],
          "properties": {
            "unset": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calc",
            "to"
          ],
          "properties": {
            "calc": {
              "type": "string"
            },
            "to": {
              "$ref": "#/definitions/expr"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tag"
          ],
          "properties": {
            "tag": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "condition"
          ],
          "properties": {
            "condition": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item"
          ],
          "properties": {
            "item": {
              "type": "string"
            },
            "why": {
              "type": "string"
            },
            "quiet": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lose"
          ],
          "properties": {
            "lose": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lose_matching"
          ],
          "properties": {
            "lose_matching": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hook"
          ],
          "properties": {
            "hook": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unhook"
          ],
          "properties": {
            "unhook": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rumour"
          ],
          "properties": {
            "rumour": {
              "$ref": "#/definitions/rumour"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "persona"
          ],
          "properties": {
            "persona": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pledge",
            "loan"
          ],
          "properties": {
            "pledge": {
              "type": "string"
            },
            "loan": {
              "$ref": "#/definitions/amount"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "note",
            "to"
          ],
          "properties": {
            "note": {
              "$ref": "#/definitions/amount"
            },
            "to": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "then"
          ],
          "properties": {
            "when": {
              "$ref": "#/definitions/expr"
            },
            "then": {
              "$ref": "#/definitions/effects"
            },
            "else": {
              "$ref": "#/definitions/effects"
            }
          }
        }
      ]
    },
    "rumour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "text",
        "effect"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "delay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "Weeks after the Venture (ruling: 1–3)."
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52,
          "description": "An absolute week. Only for faithful copies of older content; use delay."
        },
        "from": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "on_delivery": {
          "$ref": "#/definitions/effects"
        },
        "circle": {
          "enum": [
            "the Quality",
            "the Church",
            "the Law",
            "the Projectors",
            "the Army & Navy",
            "the Underworld",
            "the Wits",
            "the Trade",
            "the Brethren & the Adepts",
            "the Town"
          ],
          "description": "Whose talk it is; defaults to the Venture's circle."
        },
        "hindsight": {
          "type": "string",
          "description": "A footnote in the Story's voice, added to this Venture's chapter when the rumour lands (Step 9)."
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when",
            "need"
          ],
          "properties": {
            "when": {
              "$ref": "#/definitions/expr"
            },
            "need": {
              "type": "string"
            }
          }
        },
        "cost": {
          "type": "string"
        },
        "withdraw": {
          "type": "boolean"
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attr",
            "diff"
          ],
          "properties": {
            "attr": {
              "type": "string",
              "enum": [
                "Address",
                "Wit",
                "Nerve",
                "Constitution",
                "Countenance",
                "Learning"
              ]
            },
            "diff": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "bonus": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "by",
                  "why"
                ],
                "properties": {
                  "when": {
                    "$ref": "#/definitions/expr"
                  },
                  "by": {
                    "type": "integer"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "dev": {
          "type": "string"
        },
        "do": {
          "$ref": "#/definitions/outcome"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "T",
            "S",
            "C",
            "R",
            "X"
          ],
          "properties": {
            "T": {
              "$ref": "#/definitions/outcome"
            },
            "S": {
              "$ref": "#/definitions/outcome"
            },
            "C": {
              "$ref": "#/definitions/outcome"
            },
            "R": {
              "$ref": "#/definitions/outcome"
            },
            "X": {
              "$ref": "#/definitions/outcome"
            }
          }
        },
        "story": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "T": {
              "$ref": "#/definitions/passage"
            },
            "S": {
              "$ref": "#/definitions/passage"
            },
            "C": {
              "$ref": "#/definitions/passage"
            },
            "R": {
              "$ref": "#/definitions/passage"
            },
            "X": {
              "$ref": "#/definitions/passage"
            },
            "M": {
              "$ref": "#/definitions/passage"
            }
          }
        },
        "next": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "go"
                ],
                "properties": {
                  "when": {
                    "$ref": "#/definitions/expr"
                  },
                  "go": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "price": {
          "$ref": "#/definitions/amount"
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "num",
        "phase",
        "title",
        "sid",
        "text",
        "ask",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "num": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "The Approach",
            "The Complication",
            "The Turn",
            "The Crisis"
          ]
        },
        "title": {
          "type": "string"
        },
