{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The Origins",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "sex",
      "arrives",
      "strengths",
      "secret",
      "available"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z-]+$"
      },
      "name": {
        "type": "string"
      },
      "sex": {
        "enum": [
          "man",
          "woman",
          "either"
        ]
      },
      "arrives": {
        "type": "string"
      },
      "strengths": {
        "type": "string"
      },
      "secret": {
        "type": "string"
      },
      "available": {
        "type": "boolean"
      },
      "arrival": {
        "type": "string",
        "description": "The id of the arrival Venture, played in the first turn."
      },
      "hero": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "names",
          "true_rank",
          "claimed_rank",
          "lodging",
          "start",
          "dress"
        ],
        "properties": {
          "true_rank": {
            "$ref": "#/definitions/rank"
          },
          "claimed_rank": {
            "$ref": "#/definitions/rank"
          },
          "lodging": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "district",
              "room"
            ],
            "properties": {
              "district": {
                "type": "string"
              },
              "room": {
                "enum": [
                  "garret",
                  "room",
                  "first floor"
                ]
              }
            }
          },
          "start": {
            "type": "object",
            "description": "As a Venture's start; checked against venture.schema.json's start."
          },
          "names": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "given",
              "surname",
              "county",
              "alias"
            ],
            "description": "Drawn afresh for each run.",
            "properties": {
              "given": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "surname": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "county": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "alias": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "surname",
                  "claim"
                ],
                "properties": {
                  "title": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "long",
                        "short"
                      ],
                      "properties": {
                        "long": {
                          "type": "string"
                        },
                        "short": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "surname": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "claim": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "dress": {
            "type": "object",
            "description": "Starting Appearances: slot → { tier 1–3, name }. Names should also be listed in start.items.",
            "additionalProperties": false,
            "properties": {
              "Coat": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Wig": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Linen": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Sword": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Servant": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "Equipage": {
                "type": "object",
                "required": [
                  "tier",
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "tier": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "alias_kind": {
            "type": "string",
            "description": "The kind of Persona (settings.yaml personas.kinds) the Origin's drawn alias is."
          },
          "secret_out": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "letter",
              "story"
            ],
            "description": "What the Origin's Secret costs when it comes out (Step 7).",
            "properties": {
              "credit_rank": {
                "enum": [
                  "Vagabond",
                  "Servant",
                  "Tradesman",
                  "Gentleman",
                  "Esquire",
                  "Baronet or Knight",
                  "Peer"
                ]
              },
              "weeks": {
                "type": "integer",
                "minimum": 1
              },
              "tag": {
                "type": "string"
              },
              "hook": {
                "type": "string"
              },
              "letter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "text"
                ],
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "story": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "heading",
                  "text"
                ],
                "properties": {
                  "heading": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              },
              "reversal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hook",
                  "chance",
                  "letter",
                  "story"
                ],
                "properties": {
                  "hook": {
                    "type": "string"
                  },
                  "chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "true_rank": {
                    "enum": [
                      "Vagabond",
                      "Servant",
                      "Tradesman",
                      "Gentleman",
                      "Esquire",
                      "Baronet or Knight",
                      "Peer"
                    ]
                  },
                  "letter": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "text"
                    ],
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  },
                  "story": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "heading",
                      "text"
                    ],
                    "properties": {
                      "heading": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "rank": {
      "enum": [
        "Vagabond",
        "Servant",
        "Tradesman",
        "Gentleman",
        "Esquire",
        "Baronet or Knight",
        "Peer"
      ]
    }
  }
}