{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The run's numbers",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn_weeks", "living", "lodging", "room", "start_range"],
  "properties": {
    "turn_weeks": { "type": "integer", "minimum": 1 },
    "living": {
      "type": "object", "additionalProperties": false,
      "required": ["Vagabond", "Servant", "Tradesman", "Gentleman", "Esquire", "Baronet or Knight", "Peer"],
      "patternProperties": { ".*": { "type": ["string", "number"] } }
    },
    "lodging": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
    "room": {
      "type": "object", "additionalProperties": false, "required": ["garret", "room", "first floor"],
      "properties": { "garret": { "type": "number" }, "room": { "type": "number" }, "first floor": { "type": "number" } }
    },
    "start": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["year", "week"], "additionalProperties": false,
          "properties": { "year": { "type": "integer", "minimum": 1719, "maximum": 1745 }, "week": { "type": "integer", "minimum": 1, "maximum": 52 } } }
      ]
    },
    "start_range": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": { "from": { "type": "integer" }, "to": { "type": "integer" } }
    }
  }
}
