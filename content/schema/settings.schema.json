{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The run's numbers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "turn_weeks",
    "living",
    "lodging",
    "room",
    "start_range",
    "factions",
    "humours",
    "tags"
  ],
  "properties": {
    "turn_weeks": {
      "type": "integer",
      "minimum": 1
    },
    "living": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Vagabond",
        "Servant",
        "Tradesman",
        "Gentleman",
        "Esquire",
        "Baronet or Knight",
        "Peer"
      ],
      "patternProperties": {
        ".*": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "lodging": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number"
        ]
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "garret",
        "room",
        "first floor"
      ],
      "properties": {
        "garret": {
          "type": "number"
        },
        "room": {
          "type": "number"
        },
        "first floor": {
          "type": "number"
        }
      }
    },
    "start": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "year",
            "week"
          ],
          "additionalProperties": false,
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 1719,
              "maximum": 1745
            },
            "week": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            }
          }
        }
      ]
    },
    "start_range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        }
      }
    },
    "economy": {
      "type": "object",
      "description": "The core economy (Step 6); checked by the build.",
      "required": [
        "expected",
        "credit",
        "wear",
        "catalogue",
        "values",
        "pawn",
        "lender",
        "notes",
        "tradesman",
        "savoy",
        "prison"
      ]
    },
    "personas": {
      "type": "object",
      "description": "The false self (Step 7); checked by the build.",
      "required": [
        "limit",
        "cool_weeks",
        "closed_weeks",
        "blown_celebrity",
        "secret_diff",
        "scandal",
        "sale",
        "kinds"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "rank",
              "sex",
              "needs",
              "cost",
              "home",
              "titles",
              "surnames",
              "claims"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z-]+$"
              },
              "name": {
                "type": "string"
              },
              "rank": {
                "enum": [
                  "Vagabond",
                  "Servant",
                  "Tradesman",
                  "Gentleman",
                  "Esquire",
                  "Baronet or Knight",
                  "Peer"
                ]
              },
              "sex": {
                "enum": [
                  "man",
                  "woman",
                  "either"
                ]
              },
              "needs": {
                "type": "string"
              },
              "test": {
                "type": "string",
                "description": "A condition on the hero, waived for an Origin at home in the kind."
              },
              "cost": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "home": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "titles": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "man": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "long",
                        "short"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "long": {
                          "type": "string"
                        },
                        "short": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "woman": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "long",
                        "short"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "long": {
                          "type": "string"
                        },
                        "short": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "surnames": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "string"
                }
              },
              "claims": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "humours": {
      "type": "object",
      "required": [
        "peak",
        "relieved_at",
        "afflictions",
        "prodigal_upkeep",
        "torpid_offers",
        "quarrel",
        "rises",
        "relief"
      ]
    },
    "tags": {
      "type": "object",
      "required": [
        "limit",
        "lapse",
        "register"
      ],
      "properties": {
        "register": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valence"
            ],
            "properties": {
              "valence": {
                "enum": [
                  "good",
                  "bad"
                ]
              },
              "except": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "opposite": {
                "type": "string"
              },
              "lasts": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            }
          }
        }
      }
    }
  }
}